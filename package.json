{
  "name": "@sulthonzh/git-ignore-gen",
  "version": "1.1.0",
  "description": "Interactive CLI that scans your project for untracked files and suggests .gitignore patterns based on actual project state",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "git-ignore-gen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git",
    "gitignore",
    "cli",
    "generator",
    "scanner",
    "patterns",
    "interactive"
  ],
  "author": "sulthonzh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/git-ignore-gen"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^15.0.0",
    "inquirer": "^9.2.15",
    "ora": "^8.0.1"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
